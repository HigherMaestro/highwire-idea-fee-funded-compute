{
  "name": "fee-funded-compute",
  "private": true,
  "type": "module",
  "description": "An agent whose coin's creator fees pay for GPU time: it claims the fees, rents compute within a budget they cover, runs a workload in public, and posts the books on the coin's page.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "tsx src/start.ts",
    "service": "node scripts/service.mjs",
    "setup": "node scripts/setup.mjs",
    "highwire": "node scripts/highwire.mjs",
    "orders": "node scripts/highwire.mjs orders run",
    "agent": "tsx src/agent.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "highwire-agent": "0.16.0",
    "highwire-core": "0.16.0",
    "highwire-mcp": "0.16.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
